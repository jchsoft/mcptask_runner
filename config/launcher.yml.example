# Per-host-project launch command override (OPTIONAL).
#
# Copy to config/launcher.yml in the project where the runner runs to replace the
# default `claude` invocation. Each project can set its own command — the runner reads
# config/launcher.yml from the current working directory, like config/models.yml.
#
# `command:` REPLACES the leading `[claude]` of the spawned process. The runner still
# appends its own flags afterwards:
#   <command> -p <instructions> --model <id> --output-format=stream-json --verbose ...
#
# The model (--model <id>) still comes from config/models.yml, NOT from here. To test an
# alternate backend model, map a spice level there, e.g.  genius: 'minimax-m3:cloud'
#
# Example — route through an alternate launcher for occasional testing:
# command: [ollama, launch, claude]
#
# Without this file the runner autodetects the claude binary (or uses $CLAUDE_PATH).

# command: [ollama, launch, claude]
# or
# command:
#     - ollama
#     - launch
#     - claude
