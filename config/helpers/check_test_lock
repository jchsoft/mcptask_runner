#!/usr/bin/env ruby
# frozen_string_literal: true

# PreToolUse hook: blocks Bash commands that run tests/CI when test_lock is active.
# Reads tool input JSON from stdin, checks if the command matches test/CI patterns,
# and if the lock is active, blocks execution.

require "json"
require "digest"

LOCKFILE = "/tmp/claude_test_run.lock"

# run_with_log writes its pidfile under the LOCK HOLDER's per-project directory,
# so the path has to be rebuilt from the lock's own PROJECT field — the same
# slug test_lock derives. A flat ~/.claude/logs/pids has no writer anywhere, so
# pointing at one made checks 3 and 4 miss every pidfile: every lock older than
# ten seconds read as stale and this hook waved the command through.
#
# Returns nil when the lock names no project or no caller. That is not a
# staleness signal — it means the holder cannot be located, and a lock we cannot
# verify is one we must not declare dead.
def pidfile_for(project, caller_name)
  return nil if project.empty? || caller_name.empty?

  slug = Digest::SHA256.hexdigest(project)[0, 12]
  File.expand_path("~/.claude/logs/projects/#{slug}/pids/#{caller_name}.pid")
end

# Read the tool input from stdin (JSON with tool_name and tool_input)
input = JSON.parse($stdin.read) rescue {}

# Only check Bash tool calls
exit 0 unless input["tool_name"] == "Bash"

command = input.dig("tool_input", "command").to_s

# Check if command matches test/CI patterns (only actual commands, not file paths)
# Match: bin/rails test, bin/ci (as command start or after &&/;), rake test, ruby -I.*test, bundle exec.*test
test_patterns = [
  /(?:^|\s|&&|;)\s*(?:ruby\s+)?bin\/rails\s+test/,
  /(?:^|\s|&&|;)\s*(?:ruby\s+)?bin\/ci(?:\s|$)/,
  /(?:^|\s|&&|;)\s*rake\s+test/,
  /(?:^|\s|&&|;)\s*bundle\s+exec.*test/,
  /(?:^|\s|&&|;)\s*ruby\s+.*test_runner/,
  /(?:^|\s|&&|;)\s*ruby\s+-I.*test/
]

exit 0 unless test_patterns.any? { |pat| command.match?(pat) }

# Skip if the command is part of the lock mechanism itself
exit 0 if command.match?(/test_lock|run_with_log/)

# Check if lock is active
exit 0 unless File.exist?(LOCKFILE)

lock_data = {}
File.readlines(LOCKFILE).each do |line|
  key, value = line.strip.split("=", 2)
  lock_data[key] = value if key && value
end

lock_pid = lock_data["PID"].to_i
lock_started = lock_data["STARTED"].to_i
now = Time.now.to_i
age = now - lock_started

# Check if lock is stale via multiple signals
is_stale = false

# 1. Sentinel dead or age >= 900 → stale.
# Guard the non-positive case: a lock with no PID= line yields 0, and
# Process.kill(0, 0) signals the caller's own process group instead of raising
# ESRCH — so a corrupt lock would read as "sentinel alive" on the strength of
# our own liveness. Leave the verdict to the pidfile checks below instead.
if lock_pid.positive?
  begin
    Process.kill(0, lock_pid)
  rescue Errno::ESRCH, Errno::EPERM
    is_stale = true
  end
end
is_stale = true if age >= 900

# 2. COMMAND_PID set and process dead → command finished
unless is_stale
  cmd_pid = lock_data["COMMAND_PID"].to_s.strip
  if !cmd_pid.empty?
    begin
      Process.kill(0, cmd_pid.to_i)
    rescue Errno::ESRCH, Errno::EPERM
      is_stale = true
    end
  end
end

lock_caller = lock_data["CALLER"].to_s.strip
lock_project = lock_data["PROJECT"].to_s.strip
pidfile = pidfile_for(lock_project, lock_caller)

# 3. PID file gone + lock age >= 10s → run_with_log completed
unless is_stale || pidfile.nil?
  is_stale = true if !File.exist?(pidfile) && age >= 10
end

# 4. PID file exists but PID inside dead → run_with_log crashed
unless is_stale || pidfile.nil?
  if File.exist?(pidfile)
    rwl_pid = File.read(pidfile).strip.to_i
    if rwl_pid > 0
      begin
        Process.kill(0, rwl_pid)
      rescue Errno::ESRCH, Errno::EPERM
        is_stale = true
      end
    end
  end
end

if is_stale
  # Lock is stale, allow
  exit 0
end

# Lock is active, block the command
$stderr.puts "BLOCKED: Test lock is active. Another test/CI run is in progress."
$stderr.puts "  Caller: #{lock_data['CALLER']}"
$stderr.puts "  Command: #{lock_data['COMMAND']}"
$stderr.puts "  Project: #{lock_data['PROJECT']}"
$stderr.puts "  Started: #{lock_data['HUMAN_TIME']} (#{age}s ago)"
$stderr.puts ""
$stderr.puts "Use the test-runner or ci-runner skill instead of running tests directly."
$stderr.puts "Wait for the current run to finish, or use '~/.claude/bin/test_lock status' to check."
exit 2
